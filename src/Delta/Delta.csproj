<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Delta</RootNamespace>
    <AssemblyName>Delta</AssemblyName>
    <Version>1.0.0</Version>
    <Description>MEP-oriented element filtering nodes for Revit.</Description>
    <Company>Metropolitan CIM</Company>
    <Product>Delta</Product>
    <Copyright>Copyright (c) 2026 Metropolitan CIM</Copyright>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <RevitInstall Condition="'$(RevitInstall)' == ''">C:\Program Files\Autodesk\Revit 2027</RevitInstall>
    <DynamoInstall Condition="'$(DynamoInstall)' == ''">$(RevitInstall)\AddIns\DynamoForRevit</DynamoInstall>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Delta.Engine\Delta.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstall)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstall)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DynamoServices">
      <HintPath>$(DynamoInstall)\DynamoServices.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DynamoCore">
      <HintPath>$(DynamoInstall)\DynamoCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DynamoCoreWpf">
      <HintPath>$(DynamoInstall)\DynamoCoreWpf.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ProtoCore">
      <HintPath>$(DynamoInstall)\ProtoCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitServices">
      <HintPath>$(DynamoInstall)\Revit\RevitServices.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitNodes">
      <HintPath>$(DynamoInstall)\Revit\RevitNodes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DynamoInstall)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyPackageLayout" AfterTargets="Build">
    <PropertyGroup>
      <PackageRoot>$(MSBuildThisFileDirectory)..\..\dist\Delta\</PackageRoot>
    </PropertyGroup>
    <MakeDir Directories="$(PackageRoot)bin;$(PackageRoot)extra;$(PackageRoot)doc;$(PackageRoot)dyf" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageRoot)bin" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(PackageRoot)bin" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="$(TargetDir)Delta.Engine.dll" DestinationFolder="$(PackageRoot)bin" />
    <Copy SourceFiles="$(TargetDir)Delta.Engine.pdb" DestinationFolder="$(PackageRoot)bin" Condition="Exists('$(TargetDir)Delta.Engine.pdb')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\package\pkg.json" DestinationFolder="$(PackageRoot)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\package\extra\Delta_ViewExtensionDefinition.xml" DestinationFolder="$(PackageRoot)extra" />
    <ItemGroup>
      <DocFiles Include="$(MSBuildThisFileDirectory)..\..\package\doc\*.md" />
    </ItemGroup>
    <Copy SourceFiles="@(DocFiles)" DestinationFolder="$(PackageRoot)doc" />
  </Target>

</Project>
